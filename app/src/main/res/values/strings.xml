<resources>
    <string name="app_name">Cover Screen</string>

    <string name="service_description">Watches which app is in front so it can pull a real recents switcher up off the nav bar on the cover panel, and drives auto rotate for the cover panel. Screen capture is used only to draw the cards and never leaves the device.</string>
    <string name="service_summary">Recents switcher and auto rotate for the cover panel</string>

    <string name="state_off">Service is off. Turn it on under Accessibility, Installed apps, Cover Screen.</string>
    <string name="state_no_panel">Service is on, but the system is only reporting one display. Fold the phone and come back.</string>
    <string name="state_on">Service is on. Cover panel found at %1$s.</string>

