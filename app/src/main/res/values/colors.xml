<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="bg">#FF000000</color>
    <color name="fg">#FFFFFFFF</color>
    <color name="dim">#FF9A9A9A</color>
    <color name="card">#FF1C1C1E</color>
    <color name="edge">#1FFFFFFF</color>

    <!-- The deck now blurs what is behind it, so the scrim only has to carry
         enough dim to keep white cards off a white wallpaper. The old #E6 was
         opaque enough that a blur underneath it would never have been seen. -->
    <color name="scrim">#A6000000</color>

    <!-- Laid over a thumbnail as it leaves the centre of the stack. -->
    <color name="veil">#FF000000</color>

    <color name="chip">#4DFFFFFF</color>
    <color name="pill">#33FFFFFF</color>
    <color name="sheet">#F2242426</color>
    <color name="sheet_press">#26FFFFFF</color>

    <!-- The notification holder sits over other apps rather than over the
         launcher, so it cannot lean on a blur or on knowing what is behind it.
         Nearly opaque, and very slightly warm, so it reads as a surface in
         front of the app rather than the app having gone dark. -->
    <color name="notif_sheet">#F0121214</color>

    <!-- Pressed state for a notification card. Opaque rather than a
         translucent white wash, because the card it covers is itself opaque
         and layering the two produced a colour that matched neither. -->
    <color name="card_press">#FF2C2C30</color>
</resources>
