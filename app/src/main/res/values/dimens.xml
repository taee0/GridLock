<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cover panel on a Z Flip 6 is 720x748 px, roughly 360x374 dp, and the
         cards show captures of that same panel, so a card is close to square.

         One UI 7 gives the centred card most of the width and lets the stack
         behind it run off both edges. 224dp of a 360dp panel is the same 62%
         share the phone deck uses, and the layout stride stays a full card
         wide because TiltStack pulls the neighbours in itself. -->
    <dimen name="card_w">224dp</dimen>
    <dimen name="card_h">252dp</dimen>
    <dimen name="shot_h">206dp</dimen>
    <dimen name="card_gap">6dp</dimen>

    <!-- One UI radius on the recents thumbnail. Larger than the old 22dp. -->
    <dimen name="card_radius">26dp</dimen>
    <dimen name="card_lift">10dp</dimen>

    <!-- How far apart in Z one step of the stack sits. -->
    <dimen name="stack_lift">7dp</dimen>

    <dimen name="deck_pad">12dp</dimen>
    <dimen name="icon">22dp</dimen>
    <dimen name="chip_pad">5dp</dimen>
    <dimen name="sheet_w">168dp</dimen>
</resources>
