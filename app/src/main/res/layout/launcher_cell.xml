<?xml version="1.0" encoding="utf-8"?>
<!-- 12dp horizontal and 16dp vertical grid spacing -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/widget_icon" />

        <!-- ImageView, not a bare View: this cell is inflated as a
             RemoteViewsFactory row by GridRemoteViewsService, and
             android.view.View is not on RemoteViews' supported-class
             whitelist. Same defect confirmed live for the identical dot view
             in launcher_row.xml (v0.10.3 hotfix); fixed here too before it
             surfaces the same way in grid view. No src is set, so nothing
             renders beyond the background drawable, same as the View it
             replaces. -->
        <ImageView
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dot"
            android:contentDescription="@null"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/app_star"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_widget_star"
            android:contentDescription="@string/fav_add"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/app_name"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.0416"
        android:textColor="@color/fg"
        android:textSize="12sp" />
</LinearLayout>
