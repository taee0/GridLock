<?xml version="1.0" encoding="utf-8"?><FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.0125"
                android:maxLines="1"
                android:text="@string/view_grid"
                android:textColor="@color/fg"
                android:textSize="16sp" />

            <!-- 40x44 rather than the 32x32 these were. 32dp is well under the
                 48dp minimum touch target, and on a panel this small the
                 toolbar is the hardest thing to hit. A full 48dp is not
                 reachable: six of them plus the header padding is 310dp of a
                 360dp panel and the title would have nowhere to go. 40x44 is
                 the largest target that still leaves the title legible. The
                 padding grows with the button so the icon stays 20dp. -->
            <ImageButton
                android:id="@+id/widget_home"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/view_grid"
                android:padding="10dp"
                android:src="@drawable/ic_widget_home" />

            <ImageButton
                android:id="@+id/widget_mode"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_mode"
                android:padding="10dp"
                android:src="@drawable/ic_widget_mode" />

            <ImageButton
                android:id="@+id/widget_recents"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/view_recent"
                android:padding="10dp"
                android:src="@drawable/ic_widget_recents" />

            <ImageButton
                android:id="@+id/widget_favorites"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/view_favorites"
                android:padding="10dp"
                android:src="@drawable/ic_widget_star" />

            <!-- Seventh button. Six already left the title only as much room
                 as six 40dp targets and the header padding allow; a seventh
                 costs one more 40dp column. Reclaiming 6dp from the header's
                 own start/end padding (14+8 to 10+6) is the only budget this
                 round spends on the title: on a 360dp panel that leaves it
                 about 64dp, enough for the short single word titles this
                 toolbar actually shows, ellipsized like every other run of
                 text here if a host reports a narrower panel. -->
            <ImageButton
                android:id="@+id/widget_search"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_search"
                android:padding="10dp"
                android:src="@drawable/ic_widget_search" />

            <ImageButton
                android:id="@+id/widget_sort"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/opt_sort"
                android:padding="10dp"
                android:src="@drawable/ic_widget_sort" />

            <ImageButton
                android:id="@+id/widget_settings"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_settings"
                android:padding="10dp"
                android:src="@drawable/ic_widget_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.0454"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="@string/sort_alpha"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <!-- Inline search close/clear (v0.10.1). Used to be a key in the
                 bottom keypad row styled exactly like every letter key, which
                 is why it read as an enter key instead of the control that
                 clears the query and leaves search. Moved next to the query
                 text it actually acts on. -->
            <TextView
                android:id="@+id/search_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/search_close"
                android:gravity="center"
                android:text="&#10005;"
                android:textColor="@color/dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/grid_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/grid_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:horizontalSpacing="12dp"
                android:numColumns="3"
                android:padding="12dp"
                android:verticalSpacing="16dp" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/widget_empty"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Inline search (v0.10), replacing the old full screen
             WidgetSearchActivity. RemoteViews cannot host a real EditText or
             the system keyboard on a secondary display, so this is a hand
             built keypad: each key is its own button appending one character
             to SearchState and re-rendering, the same tap-then-redraw shape
             every other widget button already uses. -->
        <LinearLayout
            android:id="@+id/search_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/search_results"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/search_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/search_empty"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- v0.12: was 72 lines of keys inline here. Now shared with
                 the floating cover keyboard. See search_keypad.xml. -->
            <include layout="@layout/search_keypad" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
