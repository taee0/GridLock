<?xml version="1.0" encoding="utf-8"?>
<!-- One chosen favourite in the top strip. Width must wrap: this is an item in
     a horizontal RecyclerView, and match_parent would make every chip a page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_icon" />

    <TextView
        android:id="@+id/app_name"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/dim"
        android:textSize="10sp" />
</LinearLayout>
