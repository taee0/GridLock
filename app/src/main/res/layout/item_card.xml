<?xml version="1.0" encoding="utf-8"?>
<!-- One UI 7 / 8 recents card.

     Icon chip and name sit above the thumbnail, centred, and the chip is its
     own touch target: on One UI, tapping the icon above a card opens the per
     app menu (Keep open, App info, Close), it does not switch to the app. The
     thumbnail carries no stroke, only a soft shadow and a large radius, with a
     veil laid over it that TiltStack fades up as the card leaves the centre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/card_w"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/card_gap"
    android:paddingEnd="@dimen/card_gap">

    <FrameLayout
        android:id="@+id/chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chip"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/chip_pad">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/icon"
            android:layout_height="@dimen/icon"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:shadowColor="#B0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/fg"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shot_h"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/card_lift"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/shot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Driven by TiltStack. Zero on the centred card. -->
        <View
            android:id="@+id/veil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/veil" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
