<?xml version="1.0" encoding="utf-8"?>
<!-- The floating cover keyboard.

     Two states live in one window. kb_pill is the collapsed tab; kb_full is the
     preview strip, the control bar and the shared keypad. Closing the keyboard
     collapses to the pill instead of tearing the window down, because a field
     that already holds focus emits no focus event when you tap it again, so
     there is nothing to listen for to bring a destroyed window back. The pill
     is the guaranteed way back in.

     The root is transparent and the window shrinks to wrap the pill when
     collapsed, so it never swallows touches meant for the app underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kb_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/kb_pill"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="end"
        android:layout_margin="6dp"
        android:background="@drawable/setting_card"
        android:contentDescription="@string/kb_pill"
        android:gravity="center"
        android:minWidth="54dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/kb_pill_glyph"
        android:textColor="@color/fg"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/kb_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6000000"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <!-- What you are typing, mirrored out of the target field. Some pages
             on the cover panel cannot be scrolled to reveal their own text
             box, so this is the only place the text is legible. ellipsize is
             start so the tail, where the caret is, stays on screen. -->
        <TextView
            android:id="@+id/kb_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/setting_card"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:minHeight="30dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/kb_preview_empty"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/kb_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/kb_handle"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_handle"
                android:gravity="center"
                android:text="@string/kb_handle_glyph"
                android:textColor="@color/dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/kb_shift"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_shift"
                android:gravity="center"
                android:text="@string/kb_shift_glyph"
                android:textColor="@color/fg"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/kb_num"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_numbers"
                android:gravity="center"
                android:text="@string/kb_numbers_glyph"
                android:textColor="@color/fg"
                android:textSize="11sp" />

            <!-- Caret movement. Inserting at the caret already worked; there
                 was simply no way to move the caret from out here. -->
            <TextView
                android:id="@+id/kb_left"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_left"
                android:gravity="center"
                android:text="@string/kb_left_glyph"
                android:textColor="@color/fg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/kb_right"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_right"
                android:gravity="center"
                android:text="@string/kb_right_glyph"
                android:textColor="@color/fg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/kb_enter"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_enter"
                android:gravity="center"
                android:text="@string/kb_enter_glyph"
                android:textColor="@color/fg"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/kb_close"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/setting_card"
                android:contentDescription="@string/kb_close"
                android:gravity="center"
                android:text="@string/kb_close_glyph"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>

        <include layout="@layout/search_keypad" />
    </LinearLayout>
</LinearLayout>
